@startuml
skinparam classAttributeIconSize 0
hide empty members

title CubeAL Backend Architecture

package "Entry / Route Setup" {
  class App <<EntryPoint>> {
    +configureCors(): void
    +registerMiddlewares(): void
    +registerRoutes(): void
  }

  class Server <<EntryPoint>> {
    +startServer(): Promise<void>
  }

  class ApiRoutes <<RouteRegistry>> {
    +registerHealth(): void
    +registerAuth(): void
    +registerAlgorithms(): void
    +registerSolves(): void
    +registerStats(): void
    +registerAdmin(): void
    +registerUserFormulas(): void
  }
}

package "Models / Entities" {
  class User <<Entity>> {
    -id: int
    -username: string
    -email: string
    -passwordHash: string
    -role: string
    -lastLoginAt: datetime
    -createdAt: datetime
    -updatedAt: datetime
    -lastActivityAt: datetime
    -inactiveDays: int
    -lastReminderAt: datetime
    -canReceiveReminder: boolean
    +buildUserSelectColumns(alias): string
    +mapUserRow(row): User
    +toPublicUser(user): object
  }

  class Algorithm <<Entity>> {
    -id: int
    -course: string
    -stage: string
    -category: string
    -caseCode: string
    -name: string
    -formula: string
    -description: string
    -imageUrl: string
    -videoUrl: string
    -videoStartSeconds: int
    -videoEndSeconds: int
    -difficulty: string
    -sortOrder: int
    -isActive: boolean
    -createdBy: int
    -updatedBy: int
    -createdAt: datetime
    -updatedAt: datetime
    +buildAlgorithmSelectColumns(alias): string
    +mapAlgorithmRow(row): Algorithm
    +toPublicAlgorithm(algorithm): object
  }

  class Solve <<Entity>> {
    -id: long
    -userId: int
    -durationMs: int
    -scramble: string
    -notes: string
    -createdAt: datetime
    -updatedAt: datetime
    +mapSolveRow(row): Solve
    +toPublicSolve(solve): object
    +calculateAverageWindow(solves): int
  }

  class UserFormula <<Entity>> {
    -id: long
    -userId: int
    -name: string
    -category: string
    -caseCode: string
    -formula: string
    -notes: string
    -createdAt: datetime
    -updatedAt: datetime
    +mapUserFormulaRow(row): UserFormula
    +toPublicUserFormula(userFormula): object
  }

  class ReminderLog <<Entity>> {
    -id: long
    -userId: int
    -triggerType: string
    -sentBy: int
    -inactiveDays: int
    -status: string
    -errorMessage: string
    -sentAt: datetime
  }
}

package "Repositories" {
  class PendingRepositoryFactory <<RepositoryFactory>> {
    +createPendingRepository(moduleName): object
  }

  class AuthRepository <<Repository>> {
    -schemaReady: boolean
    +ensureSchema(): Promise<boolean>
    +getMeta(): object
    +findUserById(userId: int): User
    +findUserByUsername(username: string): User
    +findUserByEmail(email: string): User
    +createUser(data): User
    +touchLastLogin(userId: int): User
    +updatePasswordHash(userId: int, passwordHash: string): User
    +countUsers(): int
  }

  class AlgorithmRepository <<Repository>> {
    -schemaReady: boolean
    +ensureSchema(): Promise<boolean>
    +getMeta(): object
    +listAlgorithms(filters, options): List<Algorithm>
    +findAlgorithmById(id: int, options): Algorithm
    +createAlgorithm(data): Algorithm
    +updateAlgorithm(id: int, updates): Algorithm
    +deleteAlgorithm(id: int): boolean
    +countAlgorithms(): int
  }

  class SolveRepository <<Repository>> {
    -schemaReady: boolean
    -hasLegacyTimeColumn: boolean
    +ensureSchema(): Promise<boolean>
    +getMeta(): object
    +listSolvesByUserId(userId: int, limit: int): List<Solve>
    +createSolveForUser(data): Solve
    +listRecentSolvesByUserId(userId: int, limit: int): List<Solve>
  }

  class StatRepository <<Repository>> {
    +ensureSchema(): Promise<boolean>
    +getMeta(): object
    +listRecentSolvesByUserId(userId: int, limit: int): List<Solve>
    +getSolveSummaryByUserId(userId: int): object
  }

  class AdminRepository <<Repository>> {
    -schemaReady: boolean
    +ensureSchema(): Promise<boolean>
    +getMeta(): object
    +listUsers(filters): List<User>
    +findUserById(userId: int): User
    +updateUser(userId: int, updates): User
    +getUserOverviewCounts(inactiveThresholdDays: int): object
    +findReminderTargetByUserId(data): User
    +createReminderLog(data): void
  }

  class UserFormulaRepository <<Repository>> {
    -schemaReady: boolean
    +ensureSchema(): Promise<boolean>
    +getMeta(): object
    +listUserFormulas(filters): List<UserFormula>
    +findUserFormulaByIdForUser(formulaId: int, userId: int): UserFormula
    +createUserFormula(data): UserFormula
    +updateUserFormula(formulaId: int, userId: int, updates): UserFormula
    +deleteUserFormula(formulaId: int, userId: int): boolean
  }
}

package "Services" {
  class AuthService <<Service>> {
    -repository: AuthRepository
    +initialize(): Promise<void>
    +getCurrentUser(userId: int): object
    +getStatus(): object
    +register(payload): object
    +login(payload): object
    +changePassword(userId: int, payload): object
  }

  class AlgorithmService <<Service>> {
    -repository: AlgorithmRepository
    +initialize(): Promise<void>
    +getStatus(): object
    +getAll(query, options): object
    +getById(id: int, options): object
    +create(payload, actorId: int): object
    +update(id: int, payload, actorId: int): object
    +remove(id: int): object
  }

  class SolveService <<Service>> {
    +initialize(): Promise<void>
    +getStatus(): object
    +getAll(userId: int, query): object
    +create(userId: int, payload): object
  }

  class StatService <<Service>> {
    +getStatus(): object
    +getOverview(userId: int): object
  }

  class ReminderService <<Service>> {
    -repository: AdminRepository
    -transporter: object
    +initialize(): Promise<void>
    +isMailConfigured(): boolean
    +getTransporter(): object
    +sendManualReminder(data): object
    +processSingleReminder(data): object
  }

  class AdminService <<Service>> {
    -repository: AdminRepository
    -algorithmRepository: AlgorithmRepository
    -reminderService: ReminderService
    +initialize(): Promise<void>
    +getStatus(): object
    +getOverview(): object
    +listUsers(query): object
    +getUserById(userId: int): object
    +updateUser(userId: int, payload): object
    +sendManualReminder(userId: int, actorUserId: int): object
  }

  class UserFormulaService <<Service>> {
    -repository: UserFormulaRepository
    +initialize(): Promise<void>
    +getStatus(): object
    +getAll(userId: int, query): object
    +create(userId: int, payload): object
    +update(userId: int, formulaId: int, payload): object
    +remove(userId: int, formulaId: int): object
  }
}

package "Routes" {
  class AuthRoutes <<Route>> {
    {field} GET /status
    {field} GET /me
    {field} POST /register
    {field} POST /login
    {field} PATCH /password
  }

  class AlgorithmRoutes <<Route>> {
    {field} GET /status
    {field} GET /
    {field} GET /:id
  }

  class SolveRoutes <<Route>> {
    {field} GET /status
    {field} GET /
    {field} POST /
  }

  class StatRoutes <<Route>> {
    {field} GET /status
    {field} GET /
  }

  class AdminRoutes <<Route>> {
    {field} GET /status
    {field} GET /
    {field} POST /uploads/images
    {field} GET /algorithms
    {field} GET /algorithms/:id
    {field} POST /algorithms
    {field} PUT /algorithms/:id
    {field} DELETE /algorithms/:id
    {field} GET /users
    {field} GET /users/:id
    {field} PATCH /users/:id
    {field} POST /users/:id/reminder
  }

  class UserFormulaRoutes <<Route>> {
    {field} GET /status
    {field} GET /
    {field} POST /
    {field} PUT /:id
    {field} DELETE /:id
  }
}

package "Controllers" {
  class HealthController <<Controller>> {
    +getHealth(req, res): Response
  }

  class AuthController <<Controller>> {
    +status(req, res): Response
    +me(req, res): Response
    +register(req, res): Response
    +login(req, res): Response
    +changePassword(req, res): Response
  }

  class AlgorithmController <<Controller>> {
    +status(req, res): Response
    +getAll(req, res): Response
    +getById(req, res): Response
  }

  class SolveController <<Controller>> {
    +status(req, res): Response
    +getAll(req, res): Response
    +create(req, res): Response
  }

  class StatController <<Controller>> {
    +status(req, res): Response
    +getOverview(req, res): Response
  }

  class AdminController <<Controller>> {
    +status(req, res): Response
    +getOverview(req, res): Response
    +listAlgorithms(req, res): Response
    +getAlgorithm(req, res): Response
    +createAlgorithm(req, res): Response
    +updateAlgorithm(req, res): Response
    +deleteAlgorithm(req, res): Response
    +uploadImage(req, res): Response
    +listUsers(req, res): Response
    +getUser(req, res): Response
    +updateUser(req, res): Response
    +sendUserReminder(req, res): Response
  }

  class UserFormulaController <<Controller>> {
    +status(req, res): Response
    +getAll(req, res): Response
    +create(req, res): Response
    +update(req, res): Response
    +remove(req, res): Response
  }
}

package "Middlewares / Utils / Config" {
  class AuthMiddleware <<Middleware>> {
    +extractBearerToken(header: string): string
    +verifyAccessToken(token: string): object
    +authenticate(req, res, next): void
    +requireRole(...roles): function
    +requireAdmin(req, res, next): void
  }

  class UploadMiddleware <<Middleware>> {
    +uploadAlgorithmImage(req, res, next): void
  }

  class NotFoundMiddleware <<Middleware>> {
    +notFound(req, res, next): void
  }

  class ErrorMiddleware <<Middleware>> {
    +handle(error, req, res, next): Response
  }

  class AsyncHandler <<Utility>> {
    +wrap(handler): function
  }

  class ApiError <<Utility>> {
    -statusCode: int
    -message: string
  }

  class Validators <<Utility>> {
    +requirePositiveInteger(value, fieldName): int
    +normalizePage(value): int
    +normalizeLimit(value, options): int
    +normalizeOptionalText(value, fieldName, maxLength): string
    +normalizeRequiredText(value, fieldName, maxLength): string
    +normalizeBoolean(value, fieldName, options): boolean
  }

  class ApiResponse <<Utility>> {
    +sendSuccess(res, data, message, statusCode): Response
  }

  class ListResponse <<Utility>> {
    +createListResponse(data): object
  }

  class SqlAssignments <<Utility>> {
    +addAssignment(assignments, params, column, value): void
  }

  class ReminderMessage <<Utility>> {
    +buildReminderMessage(user, clientUrl): object
  }

  class DatabaseConfig <<Config>> {
    -pool: object
    -databaseState: object
    +getDatabasePool(): object
    +getDatabaseState(): object
    +initializeDatabase(): object
  }

  class EnvConfig <<Config>> {
    +env: string
    +port: int
    +jwtSecret: string
    +dbEnabled: boolean
    +dbHost: string
    +dbPort: int
    +dbUser: string
    +dbPassword: string
    +dbName: string
    +dbConnectionLimit: int
    +smtpHost: string
    +smtpPort: int
    +smtpUser: string
    +smtpPassword: string
    +smtpFrom: string
    +reminderInactiveDays: int
    +reminderCooldownDays: int
    +clientUrl: string
    +clientUrls: string[]
  }

  class UploadConfig <<Config>> {
    +uploadRoot: string
    +uploadPublicPath: string
    +algorithmImageDir: string
    +algorithmImagePublicPath: string
  }
}

' ===================== RELATIONSHIPS =====================

' Bootstrap
Server --> DatabaseConfig
Server --> AuthService
Server --> SolveService
Server --> AlgorithmService
Server --> AdminService
Server --> ReminderService
Server --> UserFormulaService

App --> ApiRoutes
App --> NotFoundMiddleware
App --> ErrorMiddleware
App ..> EnvConfig
App ..> UploadConfig

ApiRoutes --> HealthController
ApiRoutes --> AuthRoutes
ApiRoutes --> AlgorithmRoutes
ApiRoutes --> SolveRoutes
ApiRoutes --> StatRoutes
ApiRoutes --> AdminRoutes
ApiRoutes --> UserFormulaRoutes

' Route -> Controller
AuthRoutes --> AuthController
AlgorithmRoutes --> AlgorithmController
SolveRoutes --> SolveController
StatRoutes --> StatController
AdminRoutes --> AdminController
UserFormulaRoutes --> UserFormulaController

' Route -> Middleware
AuthRoutes ..> AuthMiddleware
SolveRoutes ..> AuthMiddleware
StatRoutes ..> AuthMiddleware
AdminRoutes ..> AuthMiddleware
AdminRoutes ..> UploadMiddleware
UserFormulaRoutes ..> AuthMiddleware

' Controller -> Service
AuthController --> AuthService
AlgorithmController --> AlgorithmService
SolveController --> SolveService
StatController --> StatService
AdminController --> AdminService
AdminController --> AlgorithmService
UserFormulaController --> UserFormulaService
HealthController ..> DatabaseConfig

' Service -> Repository
AuthService --> AuthRepository
AlgorithmService --> AlgorithmRepository
SolveService --> SolveRepository
StatService --> StatRepository
AdminService --> AdminRepository
AdminService --> AlgorithmRepository
AdminService --> ReminderService
ReminderService --> AdminRepository
UserFormulaService --> UserFormulaRepository

' Repository -> Model
AuthRepository ..> User
AlgorithmRepository ..> Algorithm
SolveRepository ..> Solve
StatRepository ..> Solve
AdminRepository ..> User
AdminRepository ..> ReminderLog
UserFormulaRepository ..> UserFormula

' Repository -> shared infra
AuthRepository ..> DatabaseConfig
AlgorithmRepository ..> DatabaseConfig
SolveRepository ..> DatabaseConfig
StatRepository ..> DatabaseConfig
AdminRepository ..> DatabaseConfig
UserFormulaRepository ..> DatabaseConfig

AuthRepository ..> PendingRepositoryFactory
AlgorithmRepository ..> PendingRepositoryFactory
SolveRepository ..> PendingRepositoryFactory
AdminRepository ..> PendingRepositoryFactory
UserFormulaRepository ..> PendingRepositoryFactory

' Middleware / Utility relations
AuthMiddleware ..> AuthRepository
AuthMiddleware ..> User
AuthMiddleware ..> ApiError
AuthMiddleware ..> AsyncHandler
UploadMiddleware ..> UploadConfig
UploadMiddleware ..> ApiError
NotFoundMiddleware ..> ApiError
ErrorMiddleware ..> EnvConfig

AuthService ..> Validators
AuthService ..> ApiError
AuthService ..> User
AuthService ..> EnvConfig

AlgorithmService ..> Validators
AlgorithmService ..> ApiError
AlgorithmService ..> Algorithm
AlgorithmService ..> ListResponse

SolveService ..> Validators
SolveService ..> ApiError
SolveService ..> Solve

StatService ..> Solve

AdminService ..> Validators
AdminService ..> ApiError
AdminService ..> User
AdminService ..> ListResponse
AdminService ..> EnvConfig

ReminderService ..> ApiError
ReminderService ..> EnvConfig
ReminderService ..> ReminderMessage
ReminderService ..> ReminderLog

UserFormulaService ..> Validators
UserFormulaService ..> ApiError
UserFormulaService ..> UserFormula

AuthController ..> ApiResponse
AuthController ..> AsyncHandler
AlgorithmController ..> ApiResponse
AlgorithmController ..> AsyncHandler
SolveController ..> ApiResponse
SolveController ..> AsyncHandler
StatController ..> ApiResponse
StatController ..> AsyncHandler
AdminController ..> ApiResponse
AdminController ..> AsyncHandler
UserFormulaController ..> ApiResponse
UserFormulaController ..> AsyncHandler
HealthController ..> ApiResponse

AlgorithmRepository ..> SqlAssignments
AdminRepository ..> SqlAssignments
UserFormulaRepository ..> SqlAssignments

' Domain relations
User "1" -- "0..*" Solve : owns
User "1" -- "0..*" UserFormula : saves
User "1" -- "0..*" Algorithm : creates/updates
User "1" -- "0..*" ReminderLog : sends/receives

note right of ReminderLog
  Table exists in code via AdminRepository.
  There is no dedicated reminderLog.model.js yet.
end note

@enduml
